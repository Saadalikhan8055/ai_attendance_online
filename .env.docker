# ==========================================
# DOCKER DEPLOYMENT - ENVIRONMENT CONFIG
# ==========================================
# Use this file when deploying with Docker Compose

# ==========================================
# FLASK CONFIGURATION
# ==========================================
FLASK_ENV=production
FLASK_DEBUG=0
FLASK_APP=app.py
SECRET_KEY=your-super-secret-key-change-this-in-production

# ==========================================
# DATABASE CONFIGURATION (Docker Services)
# ==========================================
DB_PASSWORD=attendance_password
DATABASE_URL=postgresql://attendance_user:attendance_password@postgres:5432/attendance_db

# ==========================================
# REDIS CONFIGURATION (Docker Services)
# ==========================================
REDIS_PASSWORD=redis_password
REDIS_URL=redis://:redis_password@redis:6379/0

# ==========================================
# SERVER CONFIGURATION
# ==========================================
PORT=5000
HOST=0.0.0.0
WORKERS=4

# ==========================================
# EMAIL CONFIGURATION
# ==========================================
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password
ADMIN_EMAIL=admin@yourdomain.com

# ==========================================
# SECURITY SETTINGS
# ==========================================
SESSION_TIMEOUT=3600
PERMANENT_SESSION_LIFETIME=86400
BCRYPT_LOG_ROUNDS=12

# ==========================================
# FACE RECOGNITION SETTINGS
# ==========================================
FACE_RECOGNITION_TOLERANCE=0.6
ENABLE_LIVENESS_DETECTION=true
LIVENESS_THRESHOLD=0.85

# ==========================================
# FILE UPLOAD SETTINGS
# ==========================================
UPLOAD_FOLDER=/app/static/uploads
MAX_CONTENT_LENGTH=16777216
ALLOWED_EXTENSIONS=jpg,jpeg,png,gif,bmp

# ==========================================
# LOGGING SETTINGS
# ==========================================
LOG_LEVEL=INFO
LOG_FILE=/app/logs/attendance.log
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=10

# ==========================================
# FEATURE FLAGS
# ==========================================
ENABLE_REGISTRATION=true
ENABLE_EMAIL_VERIFICATION=true
ENABLE_TWO_FACTOR_AUTH=false
ENABLE_DARK_MODE=true
