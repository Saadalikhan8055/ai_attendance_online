# ==========================================
# AI ATTENDANCE SYSTEM - ENVIRONMENT CONFIG
# ==========================================
# Copy this file to .env and update values

# ==========================================
# FLASK CONFIGURATION
# ==========================================
FLASK_ENV=production
FLASK_DEBUG=0
FLASK_APP=app.py
SECRET_KEY=your-super-secret-key-change-this-in-production

# ==========================================
# DATABASE CONFIGURATION
# ==========================================
# For SQLite (Development/Testing)
DATABASE_URL=sqlite:///attendance.db

# For PostgreSQL (Production) - Uncomment and update as needed
# DATABASE_URL=postgresql://user:password@localhost:5432/attendance_db

# For MySQL (Alternative Production) - Uncomment and update as needed
# DATABASE_URL=mysql://user:password@localhost:3306/attendance_db

# ==========================================
# SERVER CONFIGURATION
# ==========================================
PORT=5000
HOST=0.0.0.0
WORKERS=4  # For production with Gunicorn

# ==========================================
# EMAIL CONFIGURATION
# ==========================================
# Gmail SMTP Configuration
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password  # Use App-specific password for Gmail
ADMIN_EMAIL=admin@yourdomain.com

# Alternative: Office 365
# MAIL_SERVER=smtp.office365.com
# MAIL_PORT=587
# MAIL_USERNAME=your-email@company.com
# MAIL_PASSWORD=your-password

# ==========================================
# SECURITY SETTINGS
# ==========================================
SESSION_TIMEOUT=3600  # 1 hour in seconds
PERMANENT_SESSION_LIFETIME=86400  # 24 hours
BCRYPT_LOG_ROUNDS=12  # Password hashing strength
CORS_ORIGINS=http://localhost:5000,https://yourdomain.com

# ==========================================
# FACE RECOGNITION SETTINGS
# ==========================================
# Recognition Model Path
FACE_RECOGNITION_MODEL_PATH=models/dlib_face_recognition_resnet_model_v1.dat
FACE_DETECTOR_MODEL_PATH=models/mmod_human_face_detector.dat

# Recognition Sensitivity (0.0 - 1.0)
# 0.9 = Strict (high accuracy), 0.6 = Relaxed (more matches)
FACE_RECOGNITION_TOLERANCE=0.6

# Liveness Detection
ENABLE_LIVENESS_DETECTION=true
LIVENESS_THRESHOLD=0.85

# ==========================================
# FILE UPLOAD SETTINGS
# ==========================================
UPLOAD_FOLDER=static/uploads
MAX_CONTENT_LENGTH=16777216  # 16MB
ALLOWED_EXTENSIONS=jpg,jpeg,png,gif,bmp

# ==========================================
# LOGGING SETTINGS
# ==========================================
LOG_LEVEL=INFO
LOG_FILE=logs/attendance.log
LOG_MAX_BYTES=10485760  # 10MB
LOG_BACKUP_COUNT=10

# ==========================================
# EXTERNAL SERVICES
# ==========================================
# Add any external API keys here
# TWILIO_ACCOUNT_SID=your-sid
# TWILIO_AUTH_TOKEN=your-token
# SENDGRID_API_KEY=your-key

# ==========================================
# REDIS CONFIGURATION (For Sessions/Caching)
# ==========================================
# REDIS_URL=redis://localhost:6379/0
# SESSION_TYPE=redis

# ==========================================
# FEATURE FLAGS
# ==========================================
ENABLE_REGISTRATION=true
ENABLE_EMAIL_VERIFICATION=true
ENABLE_TWO_FACTOR_AUTH=false
ENABLE_DARK_MODE=true

# ==========================================
# ANALYTICS (Optional)
# ==========================================
# GOOGLE_ANALYTICS_ID=UA-XXXXXXXXX-X
# SENTRY_DSN=https://key@sentry.io/project-id
